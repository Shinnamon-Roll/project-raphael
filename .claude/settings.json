{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/queue.py\" show",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(.claude/helpers/queue.py:*)",
      "Bash(.claude/helpers/worklog.sh:*)"
    ]
  }
}
